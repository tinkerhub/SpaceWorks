# Build-time settings for the React app (Vite inlines them into the bundle: never put a secret here).
# API root, including /api. Docker builds default to /api (same origin).
VITE_API_URL=http://localhost:8000/api
# Optional: a makerspace's public code, to build a one-makerspace site with clean routes.
# A frontend container can instead set TENANT_TOKEN / TENANT_API_URL at runtime (docs/single-tenant-frontend.md).
VITE_TENANT_TOKEN=
# Optional, rarely needed: bootstrap returns the publishable key for the configured makerspace.
VITE_PUBLIC_API_KEY=
VITE_PUBLIC_CLIENT_ID=
# Dev server only: where `npm run dev` proxies /api (default http://localhost:8000).
# VITE_DEV_PROXY_TARGET=http://localhost:8000
