POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_USER=makerspace
POSTGRES_DB=makerspace_manager
POSTGRES_APP_USER=spaceworks_app
POSTGRES_APP_PASSWORD=replace-with-a-different-strong-password
SPACEWORKS_SCHEDULER_MODE=image

MINIO_ROOT_USER=replace-with-a-random-access-key
MINIO_ROOT_PASSWORD=replace-with-a-long-random-secret

# Compose project/container prefix.
COMPOSE_PROJECT_NAME=spaceworks

SECRET_KEY=replace-with-a-long-random-secret
# Default bundled topology: the frontend, API, and browser-facing storage are served
# over plain HTTP from the same host. Use the commented TLS block below as one unit
# instead of changing individual origins piecemeal.
ALLOWED_HOSTS=inventory.example.org
CORS_ALLOWED_ORIGINS=http://inventory.example.org
# Absolute address of the app, as users type it. Used to build links that leave the
# site: outbound email (print/job notices, invitations), event check-in station links and
# payment return URLs. Unset, those links are bare paths or point at localhost.
PUBLIC_APP_BASE_URL=http://inventory.example.org
# Fernet key that encrypts every stored integration secret: per-makerspace Telegram bot
# tokens, SMTP passwords, webhook URLs, payment keys and API-client secrets. Losing it makes
# them unreadable, so back it up with this file. setup.sh generates it. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
API_CLIENT_ENC_KEY=
# Separate Fernet-format key that MACs every audit row (same command as above). Unset, new
# audit rows are stored unattested (check audit.W001). setup.sh generates it; when adding
# it later run "manage.py provision_audit_mac_keys --all". Never rotate it casually.
AUDIT_MAC_MASTER_KEY=
# Backup encryption and signing. setup.sh generates all three on first run (age recipient
# from the backend container, Ed25519 pair from apps.ed25519). Keep the private key and the
# matching age identity (in the ops work dir) safe: without them backups cannot be restored.
# BACKUP_AGE_RECIPIENT=age1...
# BACKUP_ARCHIVE_SIGNING_PRIVATE_KEY=
# BACKUP_ARCHIVE_VERIFY_PUBLIC_KEY=

# Security hardening. Leave ENABLE_HTTPS=false for the default HTTP-behind-nginx
# Docker setup. Set it to true ONLY when a proxy terminates real TLS and forwards
# X-Forwarded-Proto: https — it turns on SSL redirect, Secure cookies, and HSTS.
ENABLE_HTTPS=false
# A Secure cookie is silently dropped on a plain-HTTP origin, so staff can log in but
# are signed out on reload unless the bundled HTTP topology uses this cookie posture.
AUTH_COOKIE_SAMESITE=Lax
AUTH_COOKIE_SECURE=False
# Number of trusted reverse proxies in front of the backend, used to find the real client
# IP for rate limiting. The bundled stack has exactly one (the nginx frontend container);
# add 1 for each extra TLS proxy or CDN you put in front of it. Leaving this unset makes
# every user share a single rate-limit bucket, because the only address Django sees is
# nginx's.
TRUSTED_PROXY_COUNT=1
# Brute-force lockout (django-axes) on the Django admin login.
AXES_FAILURE_LIMIT=5

MAKERSPACE_BACKEND_IMAGE=ghcr.io/spaceworks-hq/spaceworks-backend
MAKERSPACE_FRONTEND_IMAGE=ghcr.io/spaceworks-hq/spaceworks-frontend
MAKERSPACE_IMAGE_TAG=latest
# --- MinIO-compatible images ---
# *_IMAGE values are repository names without a tag (the tag goes in *_IMAGE_TAG).
# Like any .env edit, changing them requires rerunning scripts/init-host-orchestration.sh.
# MINIO_IMAGE=pgsty/silo
# MINIO_IMAGE_TAG=RELEASE.2026-09-16T00-00-00Z
# MC_IMAGE=pgsty/mc
# MC_IMAGE_TAG=RELEASE.2026-09-16T00-00-00Z
HTTP_PORT=80

# --- Deploying a fork ---
# GitHub owner/repo whose releases this host follows (default: SpaceWorks-HQ/SpaceWorks).
# SPACEWORKS_REPOSITORY=tinkerhub/SpaceWorks
# Backend image from your lowercased repository owner's GHCR namespace; no tag here.
# MAKERSPACE_BACKEND_IMAGE=ghcr.io/tinkerhub/spaceworks-backend
# Frontend image from the same GHCR namespace; no tag here.
# MAKERSPACE_FRONTEND_IMAGE=ghcr.io/tinkerhub/spaceworks-frontend
# Any .env edit requires rerunning: bash scripts/init-host-orchestration.sh
# See docs/deploy-ec2.md; image overrides above replace the active image entries, not their tags.

# --- Check-in gated borrowing ---
# Public upstream roster URL; required when this makerspace uses checked_in mode.
# CHECKIN_API_URL=https://checkin.example.org/api/roster
# Only this purpose is eligible (default: Working on a project).
# CHECKIN_REQUIRED_PURPOSE=Working on a project
# Optional upstream timeout and lookup cache lifetime, in seconds (Compose defaults).
# CHECKIN_TIMEOUT=5.0
# CHECKIN_CACHE_SECONDS=30
# Name of the check-in system shown to borrowers ("as it appears in <name>"); blank = generic.
# CHECKIN_PROVIDER_NAME=TinkerHub
# A public roster match proves presence eligibility, not identity: anyone can enter
# another checked-in person's name. Staff still accept requests and record hand-over evidence.
# See "Check-in gated requests" in docs/INVARIANTS.md. Membership must be off.
# Set the mode itself with: manage.py set_request_access --mode checked_in --checkin-space-id N

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Makerspace <noreply@example.com>

# Public catalog images live in a separate anonymous-read bucket. Use this only
# for item photos and makerspace logo/cover images, never private evidence.
PUBLIC_IMAGE_BUCKET=public-images
AWS_S3_PUBLIC_ENDPOINT_URL=http://inventory.example.org:9000
PUBLIC_IMAGE_BASE_URL=http://inventory.example.org:9000/public-images
MINIO_CORS_ALLOWED_ORIGINS=http://inventory.example.org
PUBLIC_IMAGE_MAX_BYTES=5242880
PUBLIC_IMAGE_URL_TTL_SECONDS=300

# --- Bundled TLS topology (uncomment and change this entire block together) ---
# Keep both app origins on https:// when Caddy terminates TLS. STORAGE_DOMAIN must
# match the host in both browser-facing storage URLs, and MinIO must allow the app
# origin or browser uploads fail at CORS.
# CORS_ALLOWED_ORIGINS=https://inventory.example.org
# PUBLIC_APP_BASE_URL=https://inventory.example.org
# STORAGE_DOMAIN=files.inventory.example.org
# AWS_S3_PUBLIC_ENDPOINT_URL=https://files.inventory.example.org
# PUBLIC_IMAGE_BASE_URL=https://files.inventory.example.org/public-images
# MINIO_CORS_ALLOWED_ORIGINS=https://inventory.example.org
# CSRF_TRUSTED_ORIGINS=https://inventory.example.org
# PUBLIC_DOMAIN=inventory.example.org
# ENABLE_HTTPS=true
# AUTH_COOKIE_SAMESITE=Lax
# Use AUTH_COOKIE_SAMESITE=None instead when the frontend is on a separate origin.
# The TLS overlay forces AUTH_COOKIE_SECURE=True; do not set it to False here.

# Telegram. Per-makerspace bot tokens + group chat ids are stored (encrypted) in the
# DB; these are the optional global fallback bot and the webhook auth secret. Set
# TELEGRAM_WEBHOOK_SECRET only if you ran setWebhook with a secret_token: alerts are
# outbound-only and callbacks are acknowledged and discarded, and the webhook rejects every
# callback (fails closed) when it is unset. Most installs leave both blank.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- Managed-Postgres / Supabase mode (all default to the self-hosted localhost behavior) ---
# See docs/supabase-deployment.md. Leave these at their defaults for the bundled
# Docker (local Postgres + MinIO) stack; set them only when hosting on Supabase et al.
#
# MANAGED_POSTGRES=true makes makerspace purge suspend immutability triggers via a
# custom GUC (no superuser) instead of session_replication_role (which Supabase forbids).
MANAGED_POSTGRES=False
# Transaction-pooler runtime (Supabase port 6543) cannot keep prepared statements or
# server-side cursors: set CONN_MAX_AGE=0 and DISABLE_SERVER_SIDE_CURSORS=True there.
# Run `manage.py migrate` against the DIRECT/session-pooler URL, not the transaction pooler.
CONN_MAX_AGE=0
DISABLE_SERVER_SIDE_CURSORS=False
# Object storage presign style. "post" = MinIO/S3 browser POST policy (default, with an
# upload-time content-length-range). "put" = Supabase Storage S3 presigned PUT (no
# upload-time size policy; the backend re-validates size server-side at attach time).
STORAGE_PRESIGN_METHOD=post
# Evidence photo metadata remains immutable; this independently bounds live object
# bytes. Preview policies before enabling. Range: 30-3650 days, batch: 1-1000.
EVIDENCE_OBJECT_RETENTION_DAYS=365
EVIDENCE_OBJECT_EXPIRY_ENABLED=False
EVIDENCE_RETENTION_BATCH_SIZE=100
# Shared secret for the cron return-reminder endpoint
# (POST /api/v1/internal/cron/return-reminders, header X-Cron-Secret). The endpoint
# 404s while this is unset. Use it when you can't run `manage.py send_return_reminders`
# on a schedule (e.g. trigger from GitHub Actions / cron-job.org / pg_cron+pg_net).
CRON_SECRET=
# Stripe Connect OAuth callback. Leave blank in self-host mode.
STRIPE_CONNECT_REDIRECT_URI=
