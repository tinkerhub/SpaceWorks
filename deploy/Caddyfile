{$PUBLIC_DOMAIN} {
    encode zstd gzip

    # Infra-only endpoints (the on-demand TLS ask) are never public. Caddy runs
    # handle before reverse_proxy, so this 403 wins over the @backend proxy below.
    handle /api/v1/internal/* {
        respond 403
    }
    # Readiness is a deployment probe: healthchecks and update.sh call it inside the
    # backend container. Public liveness stays at /api/v1/health/.
    handle /api/v1/health/readiness* {
        respond 403
    }

    @backend path /api/* /static/* /docs* /redoc* /schema*
    reverse_proxy @backend backend:8000 {
        header_up X-Forwarded-Proto https
        header_up X-Forwarded-Host {host}
    }

    reverse_proxy frontend:80
}

# Expose the S3-compatible API through its dedicated storage hostname, matching Caddyfile.saas.
# A Caddy site address cannot be omitted conditionally, so the default uses an internal
# certificate for files.localhost instead of attempting public ACME when no domain is configured.
{$STORAGE_DOMAIN:files.localhost} {
    reverse_proxy minio:9000
}
